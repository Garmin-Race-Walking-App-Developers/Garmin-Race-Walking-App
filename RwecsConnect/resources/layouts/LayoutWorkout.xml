<layout id="LayoutWorkout">

    <drawable id= "border1" />
    <drawable id= "border2" />

    <bitmap id="heartRate" x="17%" y="10%" filename="../workout_images/heart_rate.png" />
    <bitmap id="loc" x="20%" y="40%" filename="../workout_images/loc.png" />

    <text-area
        id="hrLabel"
        x="15%"  y="10%"  width="80%" height="60%"
        text="@Strings.hrLabel" 
        color="Graphics.COLOR_WHITE" 
        justification="Graphics.TEXT_JUSTIFY_CENTER">
        <fonts>
            <font>Graphics.FONT_NUMBER_MEDIUM</font>
            <font>Graphics.FONT_NUMBER_MILD</font>  
        </fonts>
    </text-area>

    <text-area 
        id="locLabel"
        x="15%"  y="33%"  width="80%" height="60%"
        text="@Strings.locLabel" 
        color="Graphics.COLOR_WHITE" 
        justification="Graphics.TEXT_JUSTIFY_CENTER">
        <fonts>
            <font>Graphics.FONT_NUMBER_HOT</font>
            <font>Graphics.FONT_NUMBER_MEDIUM</font>
            <font>Graphics.FONT_NUMBER_MILD</font>            
        </fonts>
    </text-area>


    <text-area 
        id="timerLabel"
        x="center"  y="75%"  width="80%" height="60%"
        text="@Strings.timerLabel" 
        color="Graphics.COLOR_WHITE" 
        justification="Graphics.TEXT_JUSTIFY_CENTER">
       <fonts>
            <font>Gfx.FONT_SMALL</font>            
            <font>Gfx.FONT_TINY</font>
        </fonts>
    </text-area>

</layout>
